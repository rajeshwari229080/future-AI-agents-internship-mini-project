# Application Configuration
APP_NAME="Student Record Management System"
APP_ENV=development
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Database Configuration (Relative SQLite path by default)
DATABASE_URL=sqlite:///./students.db

# Optional Ollama Local AI Assistant
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT_SECONDS=10.0
